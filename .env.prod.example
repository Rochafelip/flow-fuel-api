# Ambiente prod local (docker compose). Copie para .env.prod e ajuste.
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod up --build
# NUNCA commite o .env.prod (adicione ao .gitignore).

# OBRIGATORIO: minimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-de-32-caracteres-no-minimo

# Senha do Postgres local (qualquer valor; so vale na sua maquina).
POSTGRES_PASSWORD=flowfuel

# Origens permitidas no CORS (seu front local).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Swagger UI (ligado aqui para facilitar testes manuais).
SWAGGER_ENABLED=true

# --- Email de ativacao de conta e redefinicao de senha (Gmail via SMTP) ---
# Com MAIL_ENABLED=true o codigo/link e enviado por email (SmtpAccount
# ActivationNotifier / SmtpPasswordResetNotifier). Com false (ou ausente) o
# codigo/link so aparece no log.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
# Senha de app do Google (myaccount.google.com/apppasswords) — requer
# verificacao em duas etapas ativa; NAO e a senha normal da conta.
MAIL_PASSWORD=
MAIL_FROM=seu-email@gmail.com

# URL do frontend que recebe ?token=...&email=... e chama POST /api/v1/auth/reset-password.
# OBRIGATORIO em prod/staging (fail-fast se ausente ou apontando pra localhost).
PASSWORD_RESET_LINK_BASE_URL=http://localhost:5173/reset-password

# --- Cloudflare R2 (armazenamento de imagens) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
